# Vercel Postgres (get from Vercel Dashboard → Storage → your database → .env.local tab)
DATABASE_URL=postgresql://user:password@host:5432/db?sslmode=require&pgbouncer=true
DATABASE_URL_UNPOOLED=postgresql://user:password@host:5432/db?sslmode=require

# NextAuth (generate with: openssl rand -base64 32)
AUTH_SECRET=your-secret-here
NEXTAUTH_URL=http://localhost:3000

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Engrain AI Support

# Zoho SMTP (Email Notifications)
SMTP_USER=parker@engrainai.com
SMTP_PASSWORD=your-zoho-app-password-here
SMTP_FROM=parker@engrainai.com
